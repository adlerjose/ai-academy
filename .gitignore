# ==============================================================================
# AI Academy - .gitignore
# ==============================================================================

# Documentacao interna e escopo de ideacao
docs/

# Arquivos temporarios e metadados de Sistemas Operacionais
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# Configuracoes de IDEs e Editores de Codigo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Logs de execucao e relatorios
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Caches e arquivos temporarios locais
.cache/
*.tmp
*.temp

# Variaveis de ambiente e credenciais locais (prevencao futura)
.env
.env.local
.env.*.local

