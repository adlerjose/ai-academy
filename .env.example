# ==============================================================================
# AI Academy — Variáveis de ambiente do backend (Turing)
# Copie este arquivo para ".env" e preencha os valores. NUNCA versione o .env.
#   cp .env.example .env
# ==============================================================================

# --- Provedor de IA (obrigatório preencher uma das chaves) -------------------
# A chave fica SOMENTE no servidor; nunca é enviada ao navegador.
# O provedor é detectado automaticamente pelo formato da chave
# ("AQ...." / "AIza..." -> Google Gemini / Vertex AI; "sk-..." -> OpenAI),
# ou pode ser definido explicitamente em AI_PROVIDER (gemini | openai).
GEMINI_API_KEY=
OPENAI_API_KEY=

# Modelo utilizado pelo Turing:
# - Google Gemini (padrão): gemini-3.6-flash (com fallback automático para gemini-3.5-flash)
# - OpenAI (padrão quando usar sk-...): gpt-4.1-mini (ou gpt-4.1, gpt-4o-mini)
AI_MODEL=gemini-3.6-flash

# Opcional: endpoint de um provedor compatível com a API da OpenAI
# OPENAI_BASE_URL=

# Opcional: ajustes da chamada ao modelo
OPENAI_TIMEOUT_MS=25000
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=700
OPENAI_TEMPERATURE=0.6

# --- Servidor ----------------------------------------------------------------
PORT=3000
# Use 0.0.0.0 para aceitar conexões externas (containers, rede local)
HOST=127.0.0.1
NODE_ENV=development

# Origens extras autorizadas a chamar /api (separadas por vírgula).
# O próprio servidor (same-origin) é sempre autorizado.
# Exemplo para Live Server: http://127.0.0.1:5500,http://localhost:5500
CORS_ORIGINS=

# "true" quando estiver atrás de proxy reverso (detectado automaticamente no Codespaces)
# TRUST_PROXY=false

# --- Limites de uso -----------------------------------------------------------
CHAT_MAX_MESSAGE_CHARS=1000
CHAT_MAX_HISTORY_MESSAGES=20
CHAT_MAX_HISTORY_CHARS=12000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=15
CHAT_MAX_CONCURRENT=8
CHAT_MAX_CONCURRENT_PER_IP=1

