{
  "name": "ai-academy",
  "version": "1.1.0",
  "description": "Plataforma educacional AI Academy com o assistente virtual Turing (IA integrada via backend Node.js/Express).",
  "private": true,
  "main": "server/server.js",
  "scripts": {
